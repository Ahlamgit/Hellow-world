# Copy to .env.production and fill in values before `docker compose -f docker-compose.prod.yml up`.
# ASP.NET Core reads these as Section__Key environment variables.

ASPNETCORE_ENVIRONMENT=Production

# SQL Server (required)
DB_HOST=sqlserver
DB_NAME=KhadamatiDb
DB_USER=sa
DB_PASSWORD=change-me-strong-password

ConnectionStrings__DefaultConnection=Server=${DB_HOST},1433;Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=true

# JWT (required — minimum 32 characters)
Jwt__Secret=replace-with-a-long-random-secret-at-least-32-chars
Jwt__Issuer=https://api.khadamati.com
Jwt__Audience=https://khadamati.com

# Database lifecycle (recommended for production)
Database__MigrateOnStartup=false
Database__SeedDemoData=false

# Set true only after all integration secrets are configured
Integrations__RequireProductionReady=false

# CORS / hosts (adjust for your domains)
Cors__AllowedOrigins__0=https://khadamati.com
Cors__AllowedOrigins__1=https://admin.khadamati.com
AllowedHosts=api.khadamati.com;khadamati.com;admin.khadamati.com

# Payments — Moyasar (temporary coexistence) / Areeba (target)
Payment__Provider=Moyasar
Payment__Moyasar__SecretKey=
Payment__Moyasar__PublishableKey=
Payment__Moyasar__WebhookSecret=
Payment__Areeba__MerchantId=
Payment__Areeba__ApiUsername=
Payment__Areeba__ApiPassword=
Payment__Areeba__WebhookSecret=
Payment__Areeba__CallbackUrl=https://api.khadamati.com/api/v1/webhooks/areeba
Payment__Areeba__SuccessUrl=https://khadamati.com/pay/success
Payment__Areeba__CancelUrl=https://khadamati.com/pay/cancel

# Email — SendGrid
Email__Provider=SendGrid
Email__SendGrid__ApiKey=
Email__SendGrid__FromAddress=noreply@khadamati.com

# SMS — Twilio
Sms__Provider=Twilio
Sms__Twilio__AccountSid=
Sms__Twilio__AuthToken=
Sms__Twilio__FromNumber=

# Push — Firebase / APNs
Push__Provider=firebase
Push__Firebase__ServerKey=
Push__Firebase__ProjectId=
Push__Apns__TeamId=
Push__Apns__KeyId=
Push__Apns__PrivateKey=
Push__Apns__UseSandbox=false

# Web SPA build arg (relative API path when nginx proxies /api/)
VITE_API_URL=/api/v1
