# Copy to .env.staging before running ./scripts/deploy-staging.sh
# Development providers are used for payment/email/SMS/push in staging.

ASPNETCORE_ENVIRONMENT=Staging

# SQL Server
DB_HOST=sqlserver
DB_NAME=KhadamatiStagingDb
DB_USER=sa
DB_PASSWORD=Staging@2024!Strong

# Connection string is composed by deploy scripts; docker-compose.staging.yml builds it from DB_* vars.

# JWT (required — minimum 32 characters)
Jwt__Secret=staging-jwt-secret-minimum-32-characters-long
Jwt__Issuer=https://staging-api.khadamati.com
Jwt__Audience=https://staging.khadamati.com

# Database lifecycle
Database__MigrateOnStartup=true
Database__SeedDemoData=false

# First admin (created once when no administrator exists)
Bootstrap__AdminEmail=admin@staging.khadamati.com
Bootstrap__AdminPassword=StagingAdmin@123456
Bootstrap__AdminPhone=+966500000001
Bootstrap__AdminFirstName=Staging
Bootstrap__AdminLastName=Admin

# CORS / hosts
Cors__AllowedOrigins__0=http://localhost:8080
Cors__AllowedOrigins__1=http://localhost:3000
AllowedHosts=*

# Web SPA (relative path via nginx proxy)
VITE_API_URL=/api/v1
