# KHADAMATI — localhost development (Gate A)
# Copy to .env and adjust as needed

# Application
SPRING_PROFILES_ACTIVE=dev
DEV_MODE=true
MOCK_OTP_CODE=000000

# Server
API_PORT=8080

# Database (docker-compose defaults)
DATABASE_URL=jdbc:postgresql://localhost:5432/khadamati
DATABASE_USERNAME=khadamati
DATABASE_PASSWORD=khadamati_dev

# Redis (ADR-012)
REDIS_URL=redis://localhost:6379

# JWT (localhost only — rotate for any shared environment)
JWT_SECRET=localhost-dev-secret-change-me-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Local file storage (BLOCKER-003)
STORAGE_PATH=./storage

# Market defaults (config-driven — not hardcoded in code)
DEFAULT_MARKET_CODE=LB
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=ar
DEFAULT_TIMEZONE=Asia/Beirut
DEFAULT_PHONE_COUNTRY_CODE=961

# Web apps (Vite)
VITE_API_BASE_URL=http://localhost:8080
